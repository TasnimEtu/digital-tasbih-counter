{
  "name": "digital-tasbih",
  "version": "1.0.0",
  "description": "A lightweight Digital Tasbih Counter desktop application",
  "author": "Tasnim Etu <tasnim@example.com>",
  "main": "main.js",
  "scripts": {
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.tasnim.tasbih",
    "productName": "Digital Tasbih",
    "win": { "target": "nsis" },
    "linux": { "target": ["deb", "AppImage"] },
    "mac": { "target": "dmg" }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}